---
// Photo du site, ou aplat de couleur en mode démo.
import type { Photo } from '../lib/types';

interface Props {
  photo: Photo;
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { photo, ratio = '4 / 3', sizes = '100vw', eager = false, class: cls = '' } = Astro.props;
const widths = [480, 800, 1200, 1600, 2000];
const srcset = photo.url?.includes('w=')
  ? widths.map((w) => `${photo.url!.replace(/w=\d+/, `w=${w}`)} ${w}w`).join(', ')
  : undefined;
---

<div class:list={['img', cls]} style={`aspect-ratio:${ratio};--tone:${photo.tone ?? '#e9dccf'}`}>
  {
    photo.url ? (
      <img
        src={photo.url}
        srcset={srcset}
        sizes={sizes}
        alt={photo.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        style={photo.focus ? `object-position:${photo.focus}` : undefined}
      />
    ) : (
      <div class="vide" role="img" aria-label={photo.alt}><span>Photo : {photo.alt}</span></div>
    )
  }
</div>

<style>
  .img { position: relative; overflow: hidden; background: var(--tone); border-radius: var(--rayon); }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  .vide { position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem; }
  .vide span { font-size: 0.85rem; font-weight: 600; color: rgb(255 255 255 / 0.92); text-align: center; }
</style>
