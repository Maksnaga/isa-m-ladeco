---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import ProjetCarte from '../../components/ProjetCarte.astro';
import { getProjets } from '../../lib/content';
import type { Projet } from '../../lib/types';

export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((p) => ({
    params: { slug: p.slug },
    props: {
      projet: p,
      autres: projets.filter((x) => x.slug !== p.slug && x.categorie === p.categorie).concat(projets.filter((x) => x.slug !== p.slug && x.categorie !== p.categorie)).slice(0, 3),
    },
  }));
}
const { projet, autres } = Astro.props as { projet: Projet; autres: Projet[] };
const type = projet.categorie === 'meuble' ? 'Meuble relooké' : 'Rénovation';
const infos = [
  { t: 'La demande', c: projet.demande },
  { t: 'Les contraintes', c: projet.contrainte },
].filter((x) => x.c);
---

<Base title={`${projet.titre}, ${projet.ville ?? ''}`} description={projet.resume} image={projet.couverture.url}>
  <div class="wrap">
    <nav class="fil" aria-label="Fil d’Ariane">
      <a href="/realisations">Réalisations</a> <span aria-hidden="true">/</span> <span aria-current="page">{projet.titre}</span>
    </nav>
  </div>

  <article>
    <header class="wrap tete">
      <h1>{projet.titre}</h1>
      <ul class="tags">
        <li>{type}</li>
        {projet.ville && <li>{projet.ville}</li>}
        {projet.annee && <li>{projet.annee}</li>}
      </ul>
      {projet.resume && <p class="resume">{projet.resume}</p>}
    </header>

    <div class="wrap couv"><Img photo={projet.couverture} ratio="16 / 9" eager /></div>

    {(infos.length > 0 || projet.solutionHtml) && (
      <section class="wrap details">
        {infos.map((i) => (
          <div><h2>{i.t}</h2><p>{i.c}</p></div>
        ))}
        {projet.solutionHtml && <div><h2>Ce que j’ai proposé</h2><div set:html={projet.solutionHtml} /></div>}
      </section>
    )}

    {projet.avant && projet.apres && (
      <section class="wrap ba" aria-labelledby="t-ba">
        <h2 id="t-ba">Avant / après</h2>
        <p class="secondaire">Faites glisser le curseur pour comparer.</p>
        <div class="ba__box" data-ba style="--pos:50%">
          <Img photo={projet.apres} ratio="3 / 2" />
          <div class="ba__avant"><Img photo={projet.avant} ratio="3 / 2" /></div>
          <span class="ba__tag ba__tag--g">Avant</span>
          <span class="ba__tag ba__tag--d">Après</span>
          <div class="ba__ligne" aria-hidden="true"><span></span></div>
          <input type="range" min="0" max="100" value="50" aria-label="Comparer avant et après" />
        </div>
      </section>
    )}

    {projet.galerie.length > 0 && (
      <section class="wrap galerie" aria-label="Photos du projet">
        {projet.galerie.map((g) => <Img photo={g} ratio="4 / 3" sizes="(max-width: 760px) 100vw, 50vw" />)}
      </section>
    )}
  </article>

  <section class="wrap">
    <div class="cta">
      <div>
        <h2>Un projet similaire&nbsp;?</h2>
        <p>Décrivez-le moi, je vous réponds sous 48 heures.</p>
      </div>
      <a href="/contact" class="btn">Prendre rendez-vous</a>
    </div>
  </section>

  {autres.length > 0 && (
    <section class="wrap autres">
      <h2>D’autres réalisations</h2>
      <div class="autres__grille">{autres.map((p, i) => <ProjetCarte projet={p} i={i} />)}</div>
    </section>
  )}
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((box) => {
    const input = box.querySelector('input')!;
    input.addEventListener('input', () => box.style.setProperty('--pos', input.value + '%'));
  });
</script>

<style>
  .couv :global(.img) { border: 1px solid var(--bord); box-shadow: none; animation: entre 0.9s var(--ressort) both; }
  @keyframes entre { from { opacity: 0; transform: translateY(40px) rotate(1deg); } }
  .fil { padding-top: 1.5rem; font-size: var(--t-sm); color: var(--texte-2); }
  .fil a { color: var(--texte-2); }
  .tete { padding-block: 1.5rem 2rem; }
  .tete h1 { max-width: 18em; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .tags li { background: var(--jaune); border: 1px solid var(--bord); border-radius: 3px; padding: 0.2rem 0.8rem; font-size: var(--t-sm); font-weight: 700; }
  .tags li:nth-child(2) { background: var(--rose); }
  .tags li:nth-child(3) { background: var(--menthe); }
  .resume { font-size: var(--t-lg); color: var(--texte-2); margin: 1.2rem 0 0; max-width: 36em; }

  .details { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding-block: 3rem 0; }
  .details h2 { font-size: 1.5rem; margin-bottom: 0.6rem; }
  .details p, .details :global(p) { color: var(--texte-2); }

  .ba, .galerie, .autres { margin-top: var(--section); }
  .ba h2 { margin-bottom: 0.4rem; }
  .ba__box { position: relative; overflow: hidden; border-radius: var(--rayon); border: 1px solid var(--bord); box-shadow: none; margin-top: 1.2rem; }
  .ba__avant { position: absolute; inset: 0; z-index: 1; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__avant :global(.img) { height: 100%; }
  .ba__tag { position: absolute; z-index: 2; top: 1rem; background: var(--jaune); border: 1px solid var(--bord); padding: 0.3rem 0.7rem; border-radius: 3px; font-size: var(--t-sm); font-weight: 600; }
  .ba__tag--g { left: 1rem; }
  .ba__tag--d { right: 1rem; }
  .ba__ligne { position: absolute; z-index: 2; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px; background: #fff; pointer-events: none; }
  .ba__ligne span { position: absolute; top: 50%; left: 50%; width: 2.75rem; height: 2.75rem; translate: -50% -50%; border-radius: 3px; background: #fff; box-shadow: 0 2px 10px rgb(0 0 0 / 0.25); }
  .ba__ligne span::before { content: '‹ ›'; position: absolute; inset: 0; display: grid; place-items: center; font-weight: 700; color: var(--canard); }
  .ba input { position: absolute; z-index: 3; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }
  .ba__box:has(input:focus-visible) { outline: 3px solid var(--canard); outline-offset: 2px; }

  .galerie :global(.img) { border: 1px solid var(--bord); }
  .galerie { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }

  .cta { display: flex; justify-content: space-between; align-items: center; gap: 1rem 2rem; flex-wrap: wrap; background: var(--rose); border: 1px solid var(--bord); box-shadow: none; border-radius: var(--rayon); padding: clamp(1.5rem, 4vw, 2.5rem); margin-top: var(--section); }
  .cta h2 { font-size: var(--t-h3); }
  .cta p { margin: 0.4rem 0 0; color: var(--texte-2); }

  .autres h2 { margin-bottom: 2rem; }
  .autres__grille { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }

  @media (max-width: 760px) {
    .details, .autres__grille { grid-template-columns: 1fr; }
  }
</style>
