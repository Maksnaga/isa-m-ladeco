---
import Base from '../layouts/Base.astro';
import { getPrestations, getSettings } from '../lib/content';
const s = await getSettings();
const types = [...(await getPrestations()).map((p) => p.titre), 'Relooking d’un meuble', 'Je ne sais pas encore'];
const tel = s.telephone?.replace(/\s/g, '');
---

<Base title="Contact" description="Contactez Isabelle Moiroux, décoratrice d’intérieur à Lille, pour votre projet.">
  <section class="wrap contact">
    <div class="contact__info">
      <h1>Contact</h1>
      <p class="secondaire">Présentez-moi votre projet en quelques lignes. Je vous réponds sous 48 heures pour convenir d’un rendez-vous. Le premier échange est gratuit et sans engagement.</p>
      <div class="direct">
        {s.telephone && (
          <a href={`tel:${tel}`} class="direct__item">
            <span class="direct__t">Par téléphone</span>
            <span>{s.telephone}</span>
          </a>
        )}
        {s.email && (
          <a href={`mailto:${s.email}`} class="direct__item">
            <span class="direct__t">Par e-mail</span>
            <span>{s.email}</span>
          </a>
        )}
      </div>
      <p class="secondaire zones">J’interviens à {s.zones.join(', ')}.</p>
    </div>

    <form class="form" method="POST" action={s.formEndpoint ?? `mailto:${s.email}`}>
      <div class="champ">
        <label for="type">Votre projet concerne</label>
        <select id="type" name="type">
          {types.map((t) => <option>{t}</option>)}
        </select>
      </div>
      <div class="ligne">
        <div class="champ">
          <label for="nom">Nom</label>
          <input id="nom" name="nom" required autocomplete="name" />
        </div>
        <div class="champ">
          <label for="ville">Ville du projet</label>
          <input id="ville" name="ville" autocomplete="address-level2" />
        </div>
      </div>
      <div class="ligne">
        <div class="champ">
          <label for="email">E-mail</label>
          <input id="email" type="email" name="email" required autocomplete="email" />
        </div>
        <div class="champ">
          <label for="telephone">Téléphone <span class="opt">(facultatif)</span></label>
          <input id="telephone" type="tel" name="telephone" autocomplete="tel" />
        </div>
      </div>
      <div class="champ">
        <label for="message">Votre message</label>
        <textarea id="message" name="message" rows="6" required placeholder="Par exemple : je souhaite réaménager mon séjour de 30 m², avec un budget d’environ 10 000 €."></textarea>
      </div>
      <button class="btn" type="submit">Envoyer ma demande</button>
      <p class="mention">Vos informations servent uniquement à vous répondre.</p>
    </form>
  </section>
</Base>

<script>
  const p = new URLSearchParams(location.search).get('prestation');
  const sel = document.querySelector<HTMLSelectElement>('#type');
  if (p && sel) sel.value = p;
</script>

<style>
  .contact { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 6vw, 5rem); padding-top: clamp(2rem, 5vw, 4rem); align-items: start; }
  h1 { margin-bottom: 1rem; }
  .direct { display: grid; gap: 0.75rem; margin: 2rem 0; }
  .direct__item { display: grid; gap: 0.1rem; padding: 1rem 1.2rem; background: var(--menthe); border: 1px solid var(--bord); box-shadow: none; border-radius: var(--rayon); transition: transform 0.3s var(--ressort); text-decoration: none; color: var(--texte); font-size: var(--t-lg); font-weight: 600; }
  .direct__item:hover { transform: translateY(-2px); color: var(--encre); }
  .direct__t { font-size: var(--t-sm); font-weight: 500; color: var(--texte-2); }
  .zones { font-size: var(--t-sm); }

  .form { background: var(--rose); border: 1px solid var(--bord); box-shadow: none; border-radius: var(--rayon); padding: clamp(1.5rem, 4vw, 2.5rem); display: grid; gap: 1.2rem; }
  .ligne { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .champ { display: grid; gap: 0.4rem; }
  label { font-weight: 600; }
  .opt { font-weight: 400; }
  input, select, textarea {
    font: inherit;
    color: var(--texte);
    background: #fff;
    border: 1px solid #b8b2ab;
    border-radius: 3px;
    padding: 0.75rem 0.85rem;
    min-height: 3rem;
    width: 100%;
  }
  textarea { resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--orange); outline-offset: 0; border-color: var(--orange); }
  .form .btn { justify-self: start; }
  .mention { font-size: var(--t-sm); color: var(--encre); margin: 0; }
  @media (max-width: 860px) { .contact, .ligne { grid-template-columns: 1fr; } }
</style>
