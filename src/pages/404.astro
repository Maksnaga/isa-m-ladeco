---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable">
  <section class="wrap" style="padding-block: var(--section)">
    <h1 style="margin-bottom:1rem">Cette page n’existe pas</h1>
    <p class="secondaire">Le site a été refait et l’adresse a peut-être changé.</p>
    <div class="actions">
      <a href="/" class="btn">Retour à l’accueil</a>
      <a href="/realisations" class="btn btn--second">Voir les réalisations</a>
    </div>
  </section>
</Base>
